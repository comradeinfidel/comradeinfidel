# ─── Anthropic ───────────────────────────────────────────────────────
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── Polymarket ──────────────────────────────────────────────────────
# Your Polygon wallet private key (the wallet you deposited USDC into on Polymarket)
POLYMARKET_PRIVATE_KEY=0x...

# Same wallet's public address
POLYMARKET_FUNDER_ADDRESS=0x...

# L2 API credentials — generated by running:
#   POLYMARKET_PRIVATE_KEY=0x... python -m backend.scripts.setup_polymarket
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ─── Guardrails ──────────────────────────────────────────────────────
MAX_POSITION_SIZE_USD=50       # Max USDC per single order
DAILY_LOSS_LIMIT_USD=200       # Stop trading for the day if losses exceed this
MAX_OPEN_POSITIONS=10          # Max concurrent open positions
MAX_ORDERS_PER_CYCLE=5         # Max orders the agent can place in one cycle

# ─── Agent Schedule ──────────────────────────────────────────────────
AGENT_INTERVAL_MINUTES=15      # How often the agent runs a full cycle
