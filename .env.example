# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Polymarket (Polygon chain 137)
# Your Ethereum wallet private key (hex with 0x prefix)
POLYMARKET_PRIVATE_KEY=0x...
# Generated via: python -m backend.scripts.setup_polymarket
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
# The wallet address that holds your USDC funds
POLYMARKET_FUNDER_ADDRESS=0x...

# Safety Guardrails
MAX_POSITION_SIZE_USD=50
DAILY_LOSS_LIMIT_USD=200
MAX_OPEN_POSITIONS=10
MAX_ORDERS_PER_CYCLE=5

# Agent Schedule
AGENT_INTERVAL_MINUTES=15
